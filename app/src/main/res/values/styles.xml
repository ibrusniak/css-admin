<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseButtonStyle" parent="Widget.Material3.Button">
        <item name="cornerRadius">4dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:insetRight">2dp</item>
        <item name="android:insetLeft">2dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="NormalButton" parent="BaseButtonStyle">
    </style>

    <style name="LargeTextButton" parent="BaseButtonStyle">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="BaseDialogStyle" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="NormalDialogStyle" parent="BaseDialogStyle">
    </style>

    <style name="ErrorDialogStyle" parent="BaseDialogStyle">
        <item name="android:background">@color/important_text_background</item>
    </style>

    <style name="NormalToolbarStyle" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/white</item>
        <item name="android:titleTextAppearance">@style/NormalToolbarTitleTextAppearance</item>
        <item name="titleCentered">true</item>
    </style>

    <style name="NormalToolbarTitleTextAppearance" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>